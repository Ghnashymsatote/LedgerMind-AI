generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERATOR
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  role         Role
  createdAt    DateTime  @default(now())
  sessions     Session[]
  invoices     Invoice[]
}

model Session {
  tokenHash String   @id
  userId    String   @db.Uuid
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Supplier {
  id              String         @id @default(uuid()) @db.Uuid
  name            String
  taxId           String?
  status          SupplierStatus @default(ACTIVE)
  tallyLedgerName String
  invoices        Invoice[]
}

enum InvoiceStatus {
  UPLOADED
  PROCESSING
  NEEDS_REVIEW
  EXTRACTION_FAILED
}

enum ExtractionStatus {
  PROCESSING
  SUCCEEDED
  FAILED
}

model Invoice {
  id           String        @id @default(uuid()) @db.Uuid
  supplierId   String        @db.Uuid
  uploadedById String        @db.Uuid
  fileName     String
  mimeType     String
  sizeBytes    Int
  storageKey   String        @unique
  uploadedAt   DateTime      @default(now())
  status       InvoiceStatus @default(UPLOADED)
  invoiceNumber String?
  invoiceDate   DateTime?     @db.Date
  supplierGstin String?
  buyerName     String?
  buyerGstin    String?
  currency      String        @default("INR") @db.VarChar(3)
  taxableAmount Decimal?      @db.Decimal(18, 2)
  cgstAmount    Decimal?      @db.Decimal(18, 2)
  sgstAmount    Decimal?      @db.Decimal(18, 2)
  igstAmount    Decimal?      @db.Decimal(18, 2)
  totalTax      Decimal?      @db.Decimal(18, 2)
  invoiceTotal  Decimal?      @db.Decimal(18, 2)
  extractionWarnings Json?
  extractionConfidence Json?
  supplier     Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  uploadedBy   User          @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  lines        InvoiceLine[]
  extractionRuns ExtractionRun[]

  @@index([uploadedAt, id])
  @@index([supplierId, uploadedAt, id])
  @@index([uploadedById])
}

model InvoiceLine {
  id            String   @id @default(uuid()) @db.Uuid
  invoiceId     String   @db.Uuid
  position      Int
  description   String?
  hsnSac        String?
  quantity      Decimal? @db.Decimal(18, 4)
  unitPrice     Decimal? @db.Decimal(18, 2)
  taxableAmount Decimal? @db.Decimal(18, 2)
  taxRate       Decimal? @db.Decimal(7, 4)
  cgstAmount    Decimal? @db.Decimal(18, 2)
  sgstAmount    Decimal? @db.Decimal(18, 2)
  igstAmount    Decimal? @db.Decimal(18, 2)
  totalAmount   Decimal? @db.Decimal(18, 2)
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, position])
}

model ExtractionRun {
  id          String           @id @default(uuid()) @db.Uuid
  invoiceId   String           @db.Uuid
  status      ExtractionStatus @default(PROCESSING)
  provider    String?
  model       String?
  rawResult   Json?
  error       String?
  startedAt   DateTime         @default(now())
  completedAt DateTime?
  invoice     Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, startedAt])
}
