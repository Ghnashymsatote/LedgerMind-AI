POSTGRES_DB=ledgermind
POSTGRES_USER=ledgermind
POSTGRES_PASSWORD=ledgermind_local
DATABASE_URL=postgresql://ledgermind:ledgermind_local@postgres:5432/ledgermind?schema=public
REDIS_URL=redis://redis:6379
API_BASE_URL=http://api:3001
AI_SERVICE_URL=http://ai-service:8000
WEB_PORT=3000
API_PORT=3001
# APP_ORIGIN defaults to http://127.0.0.1:<WEB_PORT>. Set it when using another origin.
INVOICE_MAX_FILE_BYTES=10485760
EXTRACTION_PROVIDER=mock
EXTRACTION_TIMEOUT_MS=30000
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=  # Local secret only. Never commit a real key.
